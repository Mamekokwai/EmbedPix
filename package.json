{
  "name": "embedpix",
  "private": true,
  "version": "0.7.6",
  "type": "module",
  "description": "面向嵌入式 UI 开发的本地图片格式转换工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run check:types && npm run check:lint && vitest run",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint . --max-warnings 0",
    "check:gif-benchmark": "node scripts/check-gif-benchmark.mjs",
    "check:gif-quality": "node scripts/check-gif-quality-benchmark.mjs",
    "check:desktop-smoke": "pwsh -NoProfile -File scripts/desktop-smoke.ps1 -SkipInstall",
    "check:compression-cli-smoke": "pwsh -NoProfile -File scripts/compression-cli-smoke.ps1 -RequireCompression",
    "check:release-config": "pwsh -NoProfile -File scripts/release-config-smoke.ps1",
    "check:release-signing-cleanup": "pwsh -NoProfile -File scripts/release-signing-preflight-cleanup-smoke.ps1",
    "check:release-signing": "pwsh -NoProfile -File scripts/release-signing-preflight.ps1",
    "check:release-deps": "pwsh -NoProfile -File scripts/release-dependency-smoke.ps1",
    "check:release-fixture": "pwsh -NoProfile -File scripts/release-fixture-smoke.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
