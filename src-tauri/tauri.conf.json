{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmbedPix",
  "mainBinaryName": "EmbedPix",
  "version": "0.8.1",
  "identifier": "io.github.zerothrax.embedpix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://photo.nywerya.xyz; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "EmbedPix"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0RTRDMUExMDc2QjIwMjgKUldRb0lHc0hvY0hrVk9GYWdONGVTaHB1aXlob0V6TGxhMTNlL3VBbVUweTJ6WFZoS3BVNGlpYXoK"
    }
  }
}
